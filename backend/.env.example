# Native Python execution only. Docker Compose uses the repository-root .env.
# Copy this file to backend/.env only when running Python outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accommodation_db
REDIS_URL=redis://localhost:6379

SECRET_KEY=replace-with-a-generated-random-secret
MODERATOR_INVITE_KEY=replace-with-a-separate-generated-secret
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Local frontend for CORS and verification/password-reset email links.
FRONTEND_URL=http://localhost:3000
AUTH_TRUSTED_PROXY_IPS=

# External integrations; leave blank only if their features are not being used.
GEMINI_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=listing-photos
AZURE_DOCUMENT_CONTAINER_NAME=verification-documents
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

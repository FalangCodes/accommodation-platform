# ==========================================
# Student Accommodation Discovery Platform
# Local Development Environment Variables
# ==========================================

# Core Settings
PROJECT_NAME="Student Accommodation Discovery Platform"

# Database Connection (Matches docker-compose.yml)
# Note: Host is 'db' when running inside Docker, 'localhost' if running outside
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/accommodation_db"

# Security (Change SECRET_KEY in production!)
SECRET_KEY="your-super-secret-key-for-local-dev-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Authentication emails: set the public frontend URL in deployed environments.
FRONTEND_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_STARTTLS=true
SMTP_SSL=false

# Separate public listing photos from private verification documents.
AZURE_STORAGE_CONTAINER_NAME="listing-photos"
AZURE_DOCUMENT_CONTAINER_NAME="verification-documents"
